# Copy to .env.local and fill in. Names only here — never commit a real value.
# Every NEXT_PUBLIC_ variable is shipped to the browser: never put a secret behind
# that prefix.

# InsForge — backend (auth, database, storage, realtime)
# The SDK reads both of these from the environment itself; nothing passes them
# explicitly. INSFORGE_ANON_KEY must be the anon_… key. InsForge's admin key starts
# with ik_, is full-access, and belongs only in .mcp.json — never in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_INSFORGE_URL=https://your-project.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_your_anon_key_here

# App origin — used to build the OAuth callback URL in actions/auth.ts.
# Must match the port the app actually runs on or the callback will not match.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog — analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Not yet used — added by the features noted. Left here so deployment config can
# be prepared ahead of time; the app runs without them until then.
# ---------------------------------------------------------------------------

# OpenAI — GPT-4o matching, extraction, synthesis (features 07, 08, 10, 13)
# OPENAI_API_KEY=

# Adzuna — job discovery (feature 10)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Browserbase — company research browser sessions (feature 13)
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
